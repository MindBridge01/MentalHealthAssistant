PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-32-plus-char-secret
PHI_ENCRYPTION_KEY=replace-with-64-hex-or-32-byte-base64-key

# Preferred when connecting to a remote PostgreSQL database.
DATABASE_URL=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mindbridge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_CA_CERT=

ADMIN_PASSWORD=
ADMIN_EMAIL=

# Required by the registration/care/community email worker.
APP_PUBLIC_URL=http://localhost:5173
REGISTRATION_ADMIN_EMAIL=admin@example.com
MAIL_FROM=MindBridge <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

EMAIL_USER=
EMAIL_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEEPSEEK_API_KEY=
MONGODB_URI=
